#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#define OLED_ADDR 0x3c
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 oled(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);
int sensor = 25;
int state1 = 0;
int Relaypin = 34;


void setup() {
  Serial.begin(9600);
  Serial.println("");
  pinMode(sensor, INPUT);
  delay(2000);
  oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);
  oled.clearDisplay();
  oled.setTextColor(WHITE);
  oled.setTextSize(1.5);
  oled.setCursor(5, 5);
  oled.println("Sensor The Door");
  oled.setCursor(5, 25);
  oled.println("Test Examples..");
  oled.display();
  pinMode(Relaypin, OUTPUT);
}
void loop() {
  oled.clearDisplay();
  state1 = digitalRead(sensor);
  if (state1 == LOW) {
    oled.clearDisplay();
    oled.setCursor(20, 5);
    oled.println("LED");
    oled.setCursor(20, 30);
    oled.println("POWER Step..");
    oled.display();
    delay(100);
    oled.clearDisplay();
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);

  } else {
    oled.clearDisplay();
    oled.setCursor(20, 5);
    oled.println("Close");
    oled.setCursor(20, 30);
    oled.println("The Door..");
    oled.display();
    digitalWrite(Relaypin, 1);
  }
}




