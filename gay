#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#define OLED_ADDR 0x3c
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 oled(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);
int sensor = 25;
int state1 = 0;
int Relaypin = 26;
void setup() {
  pinMode(sensor, INPUT);
  pinMode(Relaypin, OUTPUT);
  delay(2000);
  oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR);
  oled.clearDisplay();
  oled.setTextColor(WHITE);
  oled.setTextSize(1.5);
  oled.setCursor(5, 5);
  oled.println("Sensor Scan");
  oled.setCursor(5, 25);
  oled.println("Object..");
  oled.display();
}
void loop() {
  oled.clearDisplay();
  state1 = digitalRead(sensor);
  if (state1 == 1) {
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("==========>5");
    delay(200);
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("=========>4");
    delay(200);
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("========>3");
    delay(200);
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("=======>2");
    delay(200);
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("=======>1");
    delay(200);
    oled.clearDisplay();
    oled.setCursor(5, 5);
    oled.println("== Please Waite ==");
    oled.setCursor(5, 5);
    oled.println("Sensor Scan Object");
    digitalWrite(Relaypin, 1);
    delay(5000);
    digitalWrite(Relaypin, 0);
  } else {
    oled.clearDisplay();
    oled.setCursor(25, 5);
    oled.println("Yes");
    oled.setCursor(5, 5);
    oled.println("Object..");
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(100);
    digitalWrite(Relaypin, 1);
    delay(200);
    digitalWrite(Relaypin, 0);
    delay(1000);
  }
}
